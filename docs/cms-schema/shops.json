    {
      "idValue": "hours",
      "fieldId": "hours",
      "name": "営業時間",
      "kind": "text",
      "required": false,
      "description": "例：10:00〜19:00（水曜定休）"
    },
    {
      "idValue": "photo",
      "fieldId": "photo",
      "name": "写真",
      "kind": "media",
      "required": false,

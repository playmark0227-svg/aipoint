      "required": true,
      "multipleSelect": false,
      "selectItems": [
        { "id": "s1", "value": "飲食" },
        { "id": "s2", "value": "小売" },
        { "id": "s3", "value": "サービス" },
        { "id": "s4", "value": "その他" }
